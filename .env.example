DATABASE_URL="postgresql://ahorro:ahorro@localhost:5433/ahorrommvd?schema=public"
POSTGRES_USER=ahorro
POSTGRES_PASSWORD=ahorro
POSTGRES_DB=ahorrommvd
PORT=3900

# Semana 4 (WhatsApp + IA)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración de la app > Básica) — sin esto
# el webhook rechaza TODOS los mensajes (falla cerrado a propósito).
# WHATSAPP_APP_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# Backfill de sucursales reales (Google Places API New, "Text Search") —
# necesita billing habilitado en el proyecto de Google Cloud, aunque el uso
# real quede dentro del free tier (5.000 requests/mes). Sin esto, "npm run
# branches:sync:local/:prod" falla al arrancar, el resto de la app sigue
# andando igual.
# GOOGLE_PLACES_API_KEY=

# Solo para "npm run branches:sync:prod" — el connection string público del
# addon de Postgres en Railway (mismo nombre que usa Railway en su
# dashboard). Vive acá aparte de DATABASE_URL para que las dos convivan sin
# pisarse: DEV sigue apuntando a tu Postgres local salvo que corras
# explícitamente el script con --prod.
# DATABASE_PUBLIC_URL=
