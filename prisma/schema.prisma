generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PaymentType {
  CREDITO
  DEBITO
  AMBOS

  @@map("payment_type")
}

model Bank {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  promotions Promotion[]
  users      User[]

  @@map("banks")
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  merchantChains MerchantChain[]

  @@map("categories")
}

model MerchantChain {
  id         String @id @default(uuid())
  name       String @unique
  categoryId String @map("category_id")

  category   Category    @relation(fields: [categoryId], references: [id])
  branches   Branch[]
  promotions Promotion[]

  @@index([categoryId])
  // Declarado acá (no solo en la migración de Semana 1) para que Prisma
  // no lo vea como "drift" y proponga borrarlo en cada `migrate dev`
  // futuro — nos pasó justo armando esta migración.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "merchant_chains_name_trgm_idx")
  @@map("merchant_chains")
}

model Branch {
  id              String  @id @default(uuid())
  merchantChainId String  @map("merchant_chain_id")
  name            String
  address         String?
  neighborhood    String?
  format          String?
  latitude        Float?
  longitude       Float?

  merchantChain     MerchantChain     @relation(fields: [merchantChainId], references: [id])
  promotionBranches PromotionBranch[]
  savingLogs        SavingLog[]
  preferredByUsers  User[]            @relation("PreferredBranch")

  @@unique([merchantChainId, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "branches_name_trgm_idx")
  @@index([neighborhood(ops: raw("gin_trgm_ops"))], type: Gin, map: "branches_neighborhood_trgm_idx")
  @@map("branches")
}

model Promotion {
  id                   String      @id @default(uuid())
  bankId               String      @map("bank_id")
  merchantChainId      String      @map("merchant_chain_id")
  // Opcional porque hay beneficios reales que no son un porcentaje (el 2x1
  // de Freddo/Las Delicias en el feed de Itaú). En ese caso va benefitLabel
  // con el texto del banco. Nunca los dos vacíos a la vez.
  discountPercentage   Decimal?    @map("discount_percentage") @db.Decimal(5, 2)
  benefitLabel         String?     @map("benefit_label")
  paymentType          PaymentType @map("payment_type")
  cardName             String?     @map("card_name")
  capAmount            Decimal?    @map("cap_amount") @db.Decimal(10, 2)
  validFrom            DateTime    @map("valid_from")
  validUntil           DateTime    @map("valid_until")
  sourceUrl            String      @map("source_url")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  appliesToAllBranches Boolean     @default(true) @map("applies_to_all_branches")

  bank              Bank              @relation(fields: [bankId], references: [id])
  merchantChain     MerchantChain     @relation(fields: [merchantChainId], references: [id])
  promotionBranches PromotionBranch[]

  @@index([merchantChainId, validFrom, validUntil])
  @@index([bankId])
  @@map("promotions")
}

model PromotionBranch {
  promotionId String @map("promotion_id")
  branchId    String @map("branch_id")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([promotionId, branchId])
  @@map("promotion_branches")
}

model User {
  id                String   @id @default(uuid())
  whatsapp          String   @unique
  preferredBranchId String?  @map("preferred_branch_id")
  createdAt         DateTime @default(now()) @map("created_at")

  preferredBranch Branch?     @relation("PreferredBranch", fields: [preferredBranchId], references: [id])
  savingLogs      SavingLog[]
  // Bancos con los que el usuario dijo que tiene tarjeta — sin esto no
  // podemos filtrar las promos a lo que realmente puede usar.
  banks           Bank[]
  // Consulta (comercio/categoría) que quedó esperando a que el usuario
  // conteste "¿qué tarjetas tenés?" — se resuelve y se borra en el próximo
  // mensaje. Shape: PendingQuery (src/domain/users/pending-query.ts).
  pendingQuery    Json?       @map("pending_query")
  // De qué veníamos hablando (última consulta + recomendación resuelta) —
  // memoria de corto plazo, ~30 min, para que "600 pesos" o "y en Pocitos?"
  // no arranquen de cero. Shape: ConversationContext
  // (src/domain/users/conversation-context.ts). A diferencia de
  // pendingQuery, esto NO se borra al resolver un mensaje: se sobreescribe
  // con la consulta más reciente cada vez que hay algo real que recordar.
  conversationContext Json?   @map("conversation_context")
  // Barrio que el usuario mencionó alguna vez — a diferencia de
  // conversationContext, no vence a los 30 min: es el default de "dónde
  // está" mientras no diga uno nuevo. BrowseByCategoryUseCase lo geocodifica
  // y filtra candidatos por distancia real (ver ZoneGeocoder) — ya no es
  // solo informativo.
  knownZone           String? @map("known_zone")
  // Ciudad/departamento DISTINTO a Montevideo que el usuario dijo alguna
  // vez que es su ubicación (ej. "vivo en Maldonado"). null = asumimos
  // Montevideo (spec: "Zona: Montevideo únicamente"). Todavía no hay datos
  // de comercios reales fuera de Montevideo — mientras esto esté seteado a
  // otra cosa, el bot avisa que no puede confirmar nada ahí en vez de
  // inventar una recomendación con datos de Montevideo.
  knownCity           String? @map("known_city")

  @@map("users")
}

model SavingLog {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  branchId        String   @map("branch_id")
  amount          Decimal  @db.Decimal(10, 2)
  estimatedSaving Decimal  @map("estimated_saving") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([userId, createdAt])
  @@map("saving_logs")
}
